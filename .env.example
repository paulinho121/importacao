# Connection string do Supabase (Dashboard do projeto -> Project Settings ->
# Database -> Connection string -> modo "Transaction pooler", porta 6543).
# Em produção/serverless (Vercel) use sempre o pooler, não a conexão direta.
# Exemplo: postgresql://postgres.xxxx:password@aws-0-xx.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Usados só para Supabase Storage (upload de documentos), nunca para dados
# relacionais (isso é DATABASE_URL/Drizzle acima).
# SUPABASE_URL: Project Settings -> API -> Project URL
# SUPABASE_SERVICE_ROLE_KEY: Project Settings -> API -> service_role secret
# NUNCA exponha a service_role key ao browser (por isso sem prefixo NEXT_PUBLIC_).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
